<UserControl x:Class="ModelDesk.Desktop.Views.HubView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,4,0">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="MinHeight" Value="438" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsExpanded, ElementName=ModelReadme}" Value="True">
              <Setter Property="MinHeight" Value="640" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12">
        <Button Content="Dừng yêu cầu" Command="{Binding CancelCommand}" Style="{StaticResource CompactButton}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="14,4,0,0" />
        <StackPanel>
          <TextBlock Text="Khám phá Hugging Face" Style="{StaticResource PageTitle}" FontSize="26" Margin="0,0,0,3" />
          <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
        </StackPanel>
      </DockPanel>
      <StackPanel Grid.Row="1">
        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" MaxHeight="44" ToolTip="{Binding Error}" Margin="0,0,0,8">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="Wrap" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Error}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Panel}" Padding="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Tìm model" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,11" />
            <DockPanel Grid.Row="1" Margin="0,0,0,10">
              <Button Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource Primary}" DockPanel.Dock="Right" Padding="12,7" Margin="7,0,0,0" />
              <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tìm model trên Hugging Face" />
            </DockPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" IsReadOnly="True" RowHeight="59" HeadersVisibility="None">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Id}" />
                        <TextBlock Text="{Binding Downloads, StringFormat={}{0:N0} lượt tải}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="3" Margin="0,10,0,0">
              <Button Content="Thêm" Command="{Binding MoreCommand}" Style="{StaticResource CompactButton}" DockPanel.Dock="Right" Margin="7,0,0,0" />
              <Button Content="Mở model đã chọn" Command="{Binding OpenSelectedCommand}" Style="{StaticResource CompactButton}" />
            </DockPanel>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="110" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Mở trực tiếp: owner/model" AutomationProperties.Name="Hugging Face model ID" />
              <TextBox Grid.Column="1" Text="{Binding Revision}" Margin="8,0,0,0" ToolTip="Branch hoặc revision" AutomationProperties.Name="Revision" />
              <Button Grid.Column="2" Content="Mở" Command="{Binding OpenCommand}" Margin="8,0,0,0" Padding="14,7" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding DetailSummary}" FontFamily="Cascadia Code, Consolas" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailSummary}" Margin="0,8,0,10" />
            <DockPanel Grid.Row="2" Margin="0,0,0,9">
              <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="175" MinHeight="31" Padding="9,5" DockPanel.Dock="Right" Margin="10,0,0,0" ToolTip="Lọc tên tệp" AutomationProperties.Name="Lọc tên tệp" />
              <WrapPanel VerticalAlignment="Center">
                <Button Content="Tất cả" Command="{Binding SelectAllCommand}" Style="{StaticResource CompactButton}" Margin="0,0,6,0" />
                <Button Content="Đang lọc" Command="{Binding SelectVisibleCommand}" Style="{StaticResource CompactButton}" Margin="0,0,6,0" />
                <Button Content="Bỏ chọn" Command="{Binding SelectNoneCommand}" Style="{StaticResource CompactButton}" />
              </WrapPanel>
            </DockPanel>
            <DataGrid x:Name="ModelFilesGrid" Grid.Row="3" ItemsSource="{Binding FilesView}" RowHeight="35" AutomationProperties.Name="Danh sách tệp của model">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Chọn" Width="65">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Path}" HorizontalAlignment="Center" Margin="0" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tên tệp" Binding="{Binding Path}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Dung lượng" Binding="{Binding Size}" Width="92" IsReadOnly="True" />
                <DataGridTextColumn Header="Hash" Binding="{Binding Hash}" Width="94" IsReadOnly="True" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="4" Margin="0,11,0,0">
              <DockPanel>
                <Button Content="Thư mục…" Command="{Binding BrowseCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource CompactButton}" />
                <TextBox Text="{Binding DownloadDirectory}" MinHeight="33" Padding="9,6" ToolTip="Thư mục đích của model" AutomationProperties.Name="Thư mục tải model" />
              </DockPanel>
              <DockPanel Margin="0,9,0,0">
                <Button Content="Tải toàn bộ" Command="{Binding DownloadAllCommand}" DockPanel.Dock="Right" Style="{StaticResource CompactButton}" Margin="8,0,0,0" />
                <Button Content="Tải đã chọn" Command="{Binding DownloadSelectedCommand}" DockPanel.Dock="Right" Style="{StaticResource Primary}" MinHeight="33" Padding="12,7" Margin="9,0,0,0" />
                <TextBlock Text="{Binding SelectionSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionSummary}" />
              </DockPanel>
            </StackPanel>
            <Expander x:Name="ModelReadme" Grid.Row="5" Header="README · văn bản" Margin="0,9,0,0">
              <TextBox Text="{Binding Detail.Readme, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="170" VerticalScrollBarVisibility="Auto" FontSize="12" Margin="0,8,0,0" />
            </Expander>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>