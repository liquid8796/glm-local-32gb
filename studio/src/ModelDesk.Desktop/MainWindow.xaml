<Window x:Class="ModelDesk.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ModelDesk.Desktop.Views" Style="{StaticResource {x:Type Window}}" Title="ModelDesk" Width="1340" Height="870" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid Margin="28,20,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="78" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Grid Width="33" Height="32" Margin="0,4,13,0">
          <Path Data="M 2 27 L 2 5 L 11 14 L 20 5 L 20 27 M 28 5 L 28 27" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Grid>
        <StackPanel>
          <TextBlock Text="ModelDesk" FontSize="25" FontWeight="SemiBold" />
          <TextBlock Text="Local model workspace" Style="{StaticResource Muted}" FontSize="11.5" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,22,0">
        <TextBlock Text="Checkpoint đang chọn" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5" />
        <ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="Checkpoint đang chọn">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelId}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="260">
        <TextBlock Text="{Binding PythonStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
        <TextBlock Text="{Binding PythonPath}" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding PythonPath}" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,5" />
    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}" KeyboardNavigation.TabNavigation="Continue">
      <TabItem Header="Tổng quan">
        <v:OverviewView />
      </TabItem>
      <TabItem Header="Chạy model">
        <v:RunView DataContext="{Binding Run}" />
      </TabItem>
      <TabItem Header="Kiểm chứng">
        <v:ValidationView DataContext="{Binding Validation}" />
      </TabItem>
      <TabItem Header="Hugging Face">
        <v:HubView DataContext="{Binding Hub}" />
      </TabItem>
      <TabItem Header="Tải xuống">
        <v:DownloadsView DataContext="{Binding Downloads}" />
      </TabItem>
      <TabItem Header="Báo cáo">
        <v:ReportsView DataContext="{Binding Reports}" />
      </TabItem>
      <TabItem Header="Cài đặt">
        <v:SettingsView DataContext="{Binding Settings}" />
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" CornerRadius="8" Margin="0,16,0,0" Padding="12,8">
      <Expander IsExpanded="{Binding Task.IsExpanded}">
        <Expander.Header>
          <TextBlock Text="{Binding Task.Status}" FontSize="12" Margin="7,0,0,0" />
        </Expander.Header>
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Button Content="Dừng tác vụ" Command="{Binding Task.CancelCommand}" Style="{StaticResource CompactButton}" DockPanel.Dock="Right" />
            <Button Content="Mở thư mục log" Command="{Binding Task.OpenLogCommand}" Style="{StaticResource CompactButton}" DockPanel.Dock="Right" Margin="0,0,8,0" />
            <TextBlock Text="Nhật ký trực tiếp" Style="{StaticResource Muted}" />
          </DockPanel>
          <TextBlock Grid.Row="1" Text="{Binding Task.Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,5,0,3" />
          <TextBox Grid.Row="2" Text="{Binding Task.Log, Mode=OneWay}" IsReadOnly="True" Height="155" FontFamily="Cascadia Code, Consolas" FontSize="11" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" AutomationProperties.Name="Nhật ký tác vụ" />
        </Grid>
      </Expander>
    </Border>
  </Grid>
</Window>