<UserControl x:Class="ModelDesk.Desktop.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,12,12">
      <TextBlock Text="Không gian làm việc của bạn." Style="{StaticResource PageTitle}" />
      <TextBlock Text="Tải checkpoint, kiểm chứng dữ liệu và chạy model cục bộ từ một nơi." Style="{StaticResource Muted}" Margin="0,0,0,26" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.45*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Panel}" Padding="30">
          <StackPanel>
            <TextBlock Text="Checkpoint đang chọn" Style="{StaticResource Muted}" FontSize="12" />
            <TextBlock Text="{Binding ModelId}" FontSize="24" FontWeight="SemiBold" Margin="0,14,0,20" />
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,17" />
            <TextBlock Text="Revision đã ghim" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding Revision}" Style="{StaticResource Mono}" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Thư mục trọng số" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="{Binding ProfileDirectory}" Style="{StaticResource Mono}" />
            <WrapPanel Margin="0,25,0,0">
              <Button Content="Mở bảng chạy model" Style="{StaticResource Primary}" Command="{Binding GoRunCommand}" Margin="0,0,10,8" />
              <Button Content="Kiểm chứng checkpoint" Command="{Binding GoValidationCommand}" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="Trạng thái sẵn sàng" Style="{StaticResource Muted}" FontSize="12" />
              <TextBlock Text="{Binding Readiness}" FontSize="22" FontWeight="SemiBold" Margin="0,11,0,9" />
              <TextBlock Text="{Binding ReadinessDetail}" Style="{StaticResource Muted}" />
              <Button Content="Cập nhật kiểm tra" Command="{Binding DoctorCommand}" HorizontalAlignment="Left" Margin="0,20,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Panel}" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="Giới hạn đang cấu hình" Style="{StaticResource Muted}" FontSize="12" />
              <TextBlock Text="{Binding ResourceSummary}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,12" />
              <TextBlock Text="Tác vụ mới dùng cấu hình hiện tại. Mở báo cáo để xem giới hạn nào đã được xác minh." Style="{StaticResource Muted}" FontSize="12" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Grid Margin="0,25,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
          <StackPanel>
            <TextBlock Text="Thêm model vào thư viện" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Tìm trên Hugging Face, xem kích thước và chọn đúng các tệp cần tải. Hàng đợi tiếp tục hoạt động khi bạn dùng Python core." Style="{StaticResource Muted}" />
            <Button Content="Khám phá Hugging Face" Command="{Binding GoHubCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
          <StackPanel>
            <TextBlock Text="Theo dõi hoạt động thực tế" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Quan sát GPU trong 10 giây. Dữ liệu hiển thị đến từ tác vụ và báo cáo của máy này." Style="{StaticResource Muted}" />
            <Button Content="Quan sát GPU" Command="{Binding MonitorCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>