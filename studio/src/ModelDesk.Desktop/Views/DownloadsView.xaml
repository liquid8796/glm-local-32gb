<UserControl x:Class="ModelDesk.Desktop.Views.DownloadsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,0,0,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Hàng đợi tải xuống" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Tiến độ thực tế, tiếp tục tệp dở và giới hạn tốc độ theo cấu hình của bạn." Style="{StaticResource Muted}" Margin="0,0,0,22" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="18" Margin="0,0,0,17">
      <DockPanel>
        <TextBlock Text="{Binding Speed}" FontFamily="Cascadia Code, Consolas" FontSize="23" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
        <StackPanel>
          <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
          <WrapPanel Margin="0,12,0,0">
            <Button Content="Tiếp tục hàng đợi" Command="{Binding ResumeAllCommand}" Style="{StaticResource CompactButton}" Margin="0,0,8,0" />
            <Button Content="Tạm dừng tất cả" Command="{Binding PauseAllCommand}" Style="{StaticResource CompactButton}" Margin="0,0,8,0" />
            <Button Content="Hủy tất cả" Command="{Binding CancelAllCommand}" Style="{StaticResource CompactButton}" />
            <Button Command="{Binding ClearCommand}" Margin="8,0,0,0" ToolTip="Chỉ xóa hàng đợi. Giữ nguyên các tệp đã tải và tệp dở.">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CompactButton}"><Setter Property="Content" Value="Xóa danh sách"/><Style.Triggers><DataTrigger Binding="{Binding IsClearing}" Value="True"><Setter Property="Content" Value="Đang xóa…"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
          </WrapPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <StackPanel Grid.Row="2">
      <DockPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding VisibleSummary}" Style="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" />
        <TextBlock Text="Trạng thái" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" DisplayMemberPath="Label" Width="190" HorizontalAlignment="Left" AutomationProperties.Name="Lọc hàng đợi theo trạng thái" />
      </DockPanel>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock Text="{Binding EmptyText}" Margin="0,0,0,8">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><DataTrigger Binding="{Binding EmptyText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </StackPanel>
    <DataGrid Grid.Row="3" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedItem}" IsReadOnly="True" RowHeight="78" MinHeight="140" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Tên tệp" Width="1.2*" MinWidth="180" SortMemberPath="FileName" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding FileName}" />
                <TextBlock Text="{Binding Error}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Error}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Model" Binding="{Binding ModelId}" Width="*" MinWidth="160" SortMemberPath="ModelId" CanUserSort="True">
          <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding ModelId}"/><Setter Property="FontSize" Value="12"/></Style></DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StateLabel}" Width="105" SortMemberPath="State" />
        <DataGridTemplateColumn Header="Tiến độ" Width="160" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding SizeLabel}" FontFamily="Cascadia Code, Consolas" FontSize="10" Margin="0,0,0,8" />
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" />
                <TextBlock Text="{Binding SpeedLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Còn lại" Binding="{Binding Eta}" Width="75" CanUserSort="False" />
        <DataGridTemplateColumn Header="Thao tác" Width="235" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <WrapPanel>
                <Button Content="Dừng" Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource CompactButton}" Margin="0,0,5,4" />
                <Button Content="Tiếp" Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource CompactButton}" Margin="0,0,5,4" />
                <Button Content="Hủy" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource CompactButton}" Margin="0,0,5,4" />
                <Button Content="Mở" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource CompactButton}" Margin="0,0,0,4" />
              </WrapPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="4" Text="Xóa danh sách chỉ đặt lại hàng đợi và thống kê; các tệp đã tải và tệp dở vẫn được giữ nguyên. Có thể thêm model mới sau khi xóa." Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" />
  </Grid>
</UserControl>
