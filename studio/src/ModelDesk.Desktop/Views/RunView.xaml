<UserControl x:Class="ModelDesk.Desktop.Views.RunView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,12,12">
      <TextBlock Text="Chạy model cục bộ" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Lập kế hoạch bộ nhớ trước, sau đó chạy decoder với trọng số đã có trên máy." Style="{StaticResource Muted}" Margin="0,0,0,24" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.6*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Panel}">
          <StackPanel>
            <TextBlock Text="Đầu vào" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Thư mục trọng số" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <DockPanel>
              <Button Content="Chọn…" Command="{Binding BrowseCommand}" DockPanel.Dock="Right" Margin="10,0,0,0" />
              <TextBox Text="{Binding ModelDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Thư mục trọng số" />
            </DockPanel>
            <TextBlock Text="Nội dung prompt" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="145" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Nội dung prompt" />
            <CheckBox Content="Dùng token ID thay cho prompt" IsChecked="{Binding UseTokens}" />
            <TextBox Text="{Binding Tokens, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseTokens}" ToolTip="Ví dụ: 1,2,3" AutomationProperties.Name="Token ID, phân cách bằng dấu phẩy" />
            <TextBlock Text="Token ID phân cách bằng dấu phẩy. Prompt văn bản cần tokenizer cục bộ đã xác minh." Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" />
            <Expander Header="Tham số nâng cao" Margin="0,19,0,0">
              <StackPanel Margin="0,10,0,0">
                <TextBox Text="{Binding Advanced, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Code, Consolas" AutomationProperties.Name="Tham số chạy nâng cao" />
                <TextBlock Text="Các đối số được truyền trực tiếp vào Python, hỗ trợ dấu nháy cho giá trị có khoảng trắng." Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Cấu hình chạy" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Backend" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding Backend}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Context" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Context}" AutomationProperties.Name="Context tokens" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Token sinh thêm" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Generate}" AutomationProperties.Name="Số token sinh thêm" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Timeout (giây)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Timeout}" />
            <Button Content="1. Lập kế hoạch bộ nhớ" Command="{Binding PlanCommand}" Margin="0,26,0,10" />
            <Button Content="2. Chạy model" Command="{Binding GenerateCommand}" Style="{StaticResource Primary}" />
            <TextBlock Text="Kết quả và nhật ký xuất hiện ở thanh tác vụ bên dưới. Có thể dừng tác vụ đang chạy bất cứ lúc nào." Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>